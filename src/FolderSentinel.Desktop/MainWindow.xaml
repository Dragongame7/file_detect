<Window x:Class="FolderSentinel.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Folder Sentinel — フォルダ追加通知" Style="{StaticResource {x:Type Window}}" Width="1220" Height="840" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1C3046" Padding="22,30,18,22">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Canvas Width="40" Height="36" HorizontalAlignment="Left" Margin="0,0,0,16"><Path Data="M2,9 L15,9 L19,14 L37,14 L37,33 L2,33 Z" Fill="#A9C9FF"/><Ellipse Width="11" Height="11" Fill="#63D6B3" Canvas.Left="29" Canvas.Top="5"/></Canvas>
     <TextBlock Text="Folder" Foreground="White" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="Sentinel" Foreground="White" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" Margin="0,-3,0,8"/>
     <TextBlock Text="フォルダ追加通知" Foreground="#ADC0D6" FontSize="12" Margin="0,0,0,34"/>
     <Button x:Name="FoldersNav" Content="監視フォルダ" Click="ShowFolders" Background="#304C6C" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button x:Name="HistoryNav" Content="追加・通知の履歴" Click="ShowHistory" Background="Transparent" Foreground="#C5D2E1" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Content="アプリの設定" Click="ShowSettings" Background="Transparent" Foreground="#C5D2E1" BorderThickness="0" HorizontalContentAlignment="Left"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border BorderBrush="#3A5069" BorderThickness="0,1,0,0" Padding="0,18,0,0">
      <StackPanel><TextBlock x:Name="GlobalStatus" Text="● 監視を準備しています" Foreground="#83DDC0" FontSize="12"/><TextBlock Text="画面を閉じても、&#10;トレイで監視を続けます。" Foreground="#ADC0D6" FontSize="11" LineHeight="19" Margin="0,9,0,0"/></StackPanel>
     </Border>
     <TextBlock x:Name="VersionLabel" FontFamily="Segoe UI" FontSize="10" Foreground="#839AB5" Margin="0,23,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,25,28,16">
   <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="監視フォルダ" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="追加を見逃さず、必要なタイミングで。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="PauseButton" Content="監視を一時停止" Click="PauseClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"/></Grid>
   <Grid x:Name="FoldersPage" Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><Button Content="＋ フォルダを追加" Style="{StaticResource Primary}" Click="AddRootClick" Margin="0,0,0,14"/><Grid Margin="1,0,1,10"><TextBlock x:Name="FolderCount" Text="登録フォルダ 0" Style="{StaticResource Hint}"/><Button Content="今すぐ確認" Click="ScanClick" HorizontalAlignment="Right" Padding="4,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}"/></Grid></StackPanel>
     <ListBox x:Name="RootsList" SelectionChanged="RootSelectionChanged" AutomationProperties.Name="監視フォルダ一覧">
      <ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Column="1" Text="●" Foreground="{Binding StatusBrush}" Margin="8,0,0,0"/></Grid><TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" Margin="0,7,0,11" TextTrimming="CharacterEllipsis" MaxHeight="38"/><TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
     <Grid>
      <StackPanel x:Name="EmptyEditor" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"><TextBlock Text="新しいファイルの到着を、&#10;もっと確かに。" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="PC内や共有フォルダを追加して、&#10;フォルダごとに通知のタイミングを選べます。" Foreground="{StaticResource Muted}" TextAlignment="Center" LineHeight="23" Margin="0,20,0,24"/><Button Content="最初のフォルダを追加" Click="AddRootClick" Style="{StaticResource Primary}"/></StackPanel>
      <Grid x:Name="Editor" Visibility="Collapsed" Margin="24,22">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,16">
        <Grid Margin="0,0,0,18"><TextBlock x:Name="EditorTitle" Text="フォルダの設定" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="EnabledBox" Content="監視する" IsChecked="True" HorizontalAlignment="Right" Margin="0,0,0,0"/></Grid>
        <TextBlock Text="表示名" Style="{StaticResource Label}"/><TextBox x:Name="NameInput" MaxLength="80" AutomationProperties.Name="フォルダの表示名" Margin="0,0,0,16"/>
        <TextBlock Text="フォルダの場所" Style="{StaticResource Label}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathInput" AutomationProperties.Name="監視フォルダのパス"/><Button x:Name="BrowseButton" Grid.Column="1" Content="参照" Click="BrowseClick" Margin="8,0,0,0"/></Grid>
        <TextBlock Text="配下のサブフォルダもすべて監視します。" Style="{StaticResource Hint}" Margin="0,7,0,19"/>
        <Border Background="#F3F6FA" CornerRadius="5" Padding="12" Margin="0,0,0,22"><StackPanel><TextBlock x:Name="RuntimeStatus" Text="保存後に初回確認を開始します。" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeDetail" Style="{StaticResource Hint}" Margin="0,5,0,0"/><TextBlock x:Name="RuntimeTimes" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>
        <TextBlock Text="通知のタイミング" Style="{StaticResource Label}"/>
        <CheckBox x:Name="ImmediateBox" Content="追加を検知したら通知する" IsChecked="True"/>
        <CheckBox x:Name="ScheduledBox" Content="指定した日時にまとめて通知する" IsChecked="True" Checked="ScheduleToggle" Unchecked="ScheduleToggle"/>
        <TextBlock Text="両方選ぶと、即時通知したファイルも定期通知に含めます。" Style="{StaticResource Hint}" Margin="0,4,0,20"/>
        <StackPanel x:Name="SchedulePanel">
         <Grid Margin="0,0,0,10"><TextBlock Text="定期通知の予定" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/><Button Content="＋ 予定を追加" Click="AddScheduleClick" HorizontalAlignment="Right" Padding="9,6"/></Grid>
         <ItemsControl x:Name="SchedulesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F3F6FA" CornerRadius="5" Padding="10" Margin="0,0,0,7"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="編集" Tag="{Binding}" Click="EditScheduleClick" Padding="8,4" Margin="8,0,5,0"/><Button Content="削除" Tag="{Binding}" Click="RemoveScheduleClick" Padding="8,4"/></StackPanel><TextBlock Text="{Binding Summary}" VerticalAlignment="Center"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="時刻はPCのタイムゾーンに合わせます。存在しない日にちは月末に通知します。" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
        </StackPanel>
       </StackPanel></ScrollViewer>
       <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,15,0,0"><Grid><Button x:Name="DeleteButton" Content="登録を削除" Click="DeleteClick" HorizontalAlignment="Left" Foreground="#B14649"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="フォルダを開く" x:Name="OpenButton" Click="OpenClick" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="設定を保存" Style="{StaticResource Primary}" Click="SaveClick"/></StackPanel></Grid></Border>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
      <Button x:Name="ExportHistoryButton" Content="CSV出力" Click="ExportHistoryClick" ToolTip="検索条件に一致する全履歴を出力（1,000件の表示制限なし）" Margin="0,0,8,0"/>
      <Button x:Name="ResetHistoryButton" Content="履歴をリセット" Click="ResetHistoryClick" Foreground="#B14649"/>
     </StackPanel>
     <TextBox x:Name="HistorySearch" TextChanged="HistorySearchChanged" AutomationProperties.Name="履歴を検索" ToolTip="フォルダ名・ファイル名・パスで検索"/>
    </DockPanel>
    <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" MouseDoubleClick="HistoryDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="検出日時" Binding="{Binding DetectedLocal}" Width="155"/><DataGridTextColumn Header="フォルダ" Binding="{Binding RootName}" Width="140"/><DataGridTextColumn Header="追加されたファイル" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="通知" Binding="{Binding Notifications}" Width="205"/></DataGrid.Columns></DataGrid>
    <TextBlock x:Name="HistoryCount" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" HorizontalAlignment="Left">
    <Border Background="White" CornerRadius="8" Padding="24" BorderBrush="{StaticResource Line}" BorderThickness="1"><StackPanel><TextBlock Text="起動と通知" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><CheckBox x:Name="StartupBox" Content="Windowsへのサインイン時に自動起動する" Click="StartupClick"/><TextBlock Text="設定画面は表示せず、タスクトレイで監視を始めます。" Style="{StaticResource Hint}" Margin="0,4,0,20"/><Button Content="デスクトップ通知をテスト" Click="TestNotificationClick" HorizontalAlignment="Left"/><TextBlock x:Name="NotificationStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Background="White" CornerRadius="8" Padding="24" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,18,0,0"><StackPanel><TextBlock Text="データと動作について" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="設定と履歴は、このPC内に保存します。ファイルの本文は保存せず、外部サービスへ情報を送信しません。" LineHeight="22"/><TextBlock x:Name="DataPath" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><TextBlock Text="初回登録時の既存ファイルは通知しません。コピー中のファイルはサイズや更新時刻が安定してから通知します。通知はWindows側の設定で抑制される場合があります。" Style="{StaticResource Hint}"/><TextBlock Text="共有フォルダでは、現在サインインしているWindowsユーザーのアクセス権限を使います。リンク先フォルダは追跡しません。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><Button Content="アプリを終了" Click="ExitClick" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <TextBlock x:Name="MessageBar" Grid.Row="2" Text="フォルダを追加すると監視を開始します。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" MinHeight="20"/>
  </Grid>
 </Grid>
</Window>
